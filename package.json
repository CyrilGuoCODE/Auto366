{
  "name": "auto366",
  "version": "0.10.0",
  "description": "天学网自动化答题工具，支持各类题型答案获取和自动填写",
  "main": "main.js",
  "author": "Auto366",
  "license": "GNUV3",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyrilguocode/Auto366.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "prestart": "node scripts/prepare.js",
    "prebuild": "node scripts/prepare.js",
    "test": "node scripts/prepare.js && node --test tests/*.test.cjs",
    "test:startup": "node scripts/prepare.js && node tests/startup.cjs",
    "test:upgrade": "node scripts/prepare.js && node tests/startup.cjs --upgrade"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "archiver": "^7.0.1",
    "bootstrap-icons": "^1.13.1",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.5",
    "fs-extra": "^11.1.1",
    "http-mitm-proxy": "^1.1.0",
    "node-stream-zip": "^1.15.0",
    "posthog-node": "^5.21.2",
    "sherpa-onnx-node": "^1.13.4",
    "uuid": "^11.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.auto366.app",
    "productName": "Auto366",
    "electronLanguages": [
      "zh-CN"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*"
    ],
    "files": [
      "**/*",
      "build/preload.js",
      "!.http-mitm-proxy/**/*",
      "!.trae/**/*",
      "!.vscode/**/*",
      "!answers/**/*",
      "!dist/**/*",
      "!temp/**/*",
      "!file/**/*",
      "!.git/**/*",
      "!web/**/*",
      "!resources/tun/**/*",
      "!resources/openspeedy/**/*",
      "!resources/tts/**/*",
      "!resources/init.mp3",
      "!resources/Auto366CompatibilityMode.ps1",
      "!scripts/**/*",
      "!tests/**/*",
      "!docs/**/*"
    ],
    "extraResources": [
      {
        "from": "./resources/Auto366CompatibilityMode.ps1",
        "to": "../"
      },
      {
        "from": "./resources/init.mp3",
        "to": "./"
      },
      {
        "from": "./resources/openspeedy",
        "to": "openspeedy"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "publish": {
      "provider": "github",
      "owner": "cyrilguocode",
      "repo": "Auto366"
    }
  }
}
